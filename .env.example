ENVIRONMENT=production
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/ung_core
IAM_BASE_URL=https://YOUR-UNG-IAM-SERVICE
DATA_RELAY_BASE_URL=https://YOUR-DATA-RELAY-SERVICE
PUBLIC_BASE_URL=https://YOUR-UNG-CORE-DOMAIN
SERVICE_VERSION=1.0.0
HEALTH_POLL_ENABLED=true
HEALTH_POLL_INTERVAL_SECONDS=30
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=5
REQUEST_BODY_LIMIT_BYTES=1048576
REQUEST_TIMEOUT_SECONDS=30
SECURITY_HEADERS_ENABLED=true
PRODUCTION_REQUIRE_POSTGRES=true
PRODUCTION_REQUIRE_HTTPS_DEPENDENCIES=true
PRODUCTION_REQUIRE_PUBLIC_BASE_URL=true
TRUSTED_HOSTS=YOUR-UNG-CORE-DOMAIN
REGISTRY_BOOTSTRAP_ENABLED=true
REGISTRY_BOOTSTRAP_STRICT=true
REGISTRY_BOOTSTRAP_JSON={"organizations":[{"organization_key":"UNG","display_name":"Uganda National Grid","organization_type":"national-grid"}],"systems":[{"system_key":"UNG-IAM","display_name":"UNG Identity and Access Management","owner_organization_key":"UNG","criticality":"critical","base_url":"https://YOUR-UNG-IAM-SERVICE","capabilities":["identity","authentication","authorization"]}],"dependencies":[]}
